{
  "name": "react-template-next",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "server:mock": "json-server -c .mock/config.json .mock/data.json",
    "ut:terminal": "vitest",
    "ut:ui": "vitest --ui",
    "ut:coverage": "vitest run --coverage",
    "e2e:terminal": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "npx playwright install chromium",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint:eslint-fix": "eslint --fix src",
    "lint:check-circular": "npx madge --circular src",
    "lint:output-dependencies": "npx madge --image dependencies.svg src",
    "lint:react-doctor": "npx react-doctor@latest",
    "node_modules:remove": "npx rimraf node_modules",
    "node_modules:upgrade": "npx npm-check-updates -u",
    "prebuild": "npm run lint:check-circular && npm run lint:eslint-fix",
    "prepare": "husky install"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.{js,jsx,tsx,ts,css,less,scss,sass,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.4.0",
    "@mui/icons-material": "9.1.1",
    "@mui/material": "9.1.2",
    "@mui/x-date-pickers": "9.7.0",
    "ahooks": "3.9.7",
    "axios": "1.18.1",
    "clipboard": "2.0.11",
    "dayjs": "1.11.21",
    "immer": "11.1.9",
    "qs": "6.15.3",
    "radash": "12.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "6.1.2",
    "react-hook-form": "7.80.0",
    "react-router": "8.1.0",
    "react-router-dom": "7.18.1",
    "react-scan": "0.5.7",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-links": "10.4.6",
    "@storybook/addon-onboarding": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/react": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.2",
    "@types/qs": "6.15.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/eslint-plugin": "1.6.20",
    "@vitest/ui": "4.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "happy-dom": "20.10.6",
    "husky": "9.1.7",
    "json-server": "0.17.4",
    "lint-staged": "17.0.8",
    "npm-check-updates": "22.2.9",
    "picocolors": "1.1.1",
    "prettier": "3.9.4",
    "rollup-plugin-visualizer": "7.0.1",
    "storybook": "10.4.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "typescript-plugin-css-modules": "5.2.0",
    "vite": "8.1.2",
    "vite-plugin-node-polyfills": "0.28.0",
